{
    "name":  "it-corp/it-docs-prototype",
    "type":  "project",
    "require":  {
                    "php":  "^8.2",
                    "laravel/framework":  "^12.0",
                    "laravel/tinker":  "^2.9"
                },
    "autoload":  {
                     "psr-4":  {
                                   "App\\":  "app/"
                               },
                     "files":  [

                               ]
                 },
    "autoload-dev":  {
                    "psr-4":  {
                                   "Tests\\":  "tests/",
                                   "Database\\Seeders\\":  "database/seeders/"
                                   }
                     },
    "scripts":  {
                    "post-autoload-dump":  [
                                               "@php artisan package:discover --ansi"
                                           ]
                },
    "config":  {
                   "optimize-autoloader":  false,
                   "sort-packages":  true
               }
}
